# ===================== KiCad =====================
# KiCad 10 的本地历史本身就是一个 git 仓库，必须忽略
Hardware/**/.history/
_restore_backup_*/

# 各种自动备份 / 临时文件
*.bak
*.bak-*
*.kicad_pcb-bak
*-backups/
~*.lck
*.kicad_prl
fp-info-cache

# ===================== Software (STM32 / CubeMX / CMake) =====================
# 构建中间产物
Software/**/build/
Software/**/Debug/
Software/**/Release/
Software/**/*.o
Software/**/*.d
Software/**/*.elf
Software/**/*.map
Software/**/*.lst
Software/*.map

# CubeMX 工程缓存 / 旧的 MDK 工程（现在用 CMake）
Software/.mxproject
Software/MDK-ARM/

# CubeMX 生成的 HAL/CMSIS 驱动库（体积大，可由 .ioc 重新生成）
Software/Drivers/

# CubeMX 生成的外设初始化 / 中断文件：改它们没有意义（重新生成会被覆盖），
# 但它们可以被 .ioc 重新生成，所以不入库。
# 注意：main.c / main.h 必须入库 —— USER CODE 段里放的是我们自己的代码。
Software/Core/Src/adc.c
Software/Core/Src/dma.c
Software/Core/Src/fdcan.c
Software/Core/Src/gpio.c
Software/Core/Src/hrtim.c
Software/Core/Src/tim.c
Software/Core/Src/usart.c
Software/Core/Src/stm32g4xx_hal_msp.c
Software/Core/Src/stm32g4xx_it.c
Software/Core/Src/syscalls.c
Software/Core/Src/sysmem.c
Software/Core/Src/system_stm32g4xx.c
Software/Core/Inc/adc.h
Software/Core/Inc/dma.h
Software/Core/Inc/fdcan.h
Software/Core/Inc/gpio.h
Software/Core/Inc/hrtim.h
Software/Core/Inc/tim.h
Software/Core/Inc/usart.h
Software/Core/Inc/stm32g4xx_hal_conf.h
Software/Core/Inc/stm32g4xx_it.h

# ioc2kicad.py 生成的可再生成的图（需要留档就删掉这两行）
Software/kicad/*.svg
Software/kicad/*_preview.png

# ===================== 系统 =====================
Thumbs.db
desktop.ini
.DS_Store

# 用户手工备份目录
_backup_before_*/
_bak_before_*/
*.kicad_pcb.bak*
Hardware/G474VC_Core/_bak_before_*/
Hardware/G474VC_Core/_restore_backup_*/

# Gerber / 钻孔 / 制造输出（不入库，放本地或发布附件）
*.gbr
*.gbrjob
*.drl
*.nc
*.rar
